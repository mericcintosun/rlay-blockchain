# Frontend environment. Copy to .env.local for local development.
# Everything here is NEXT_PUBLIC_* on purpose: none of it is a secret, all of
# it ends up in the browser bundle. Never add PRIVATE_KEY or BASESCAN_API_KEY
# here - those stay in contracts/.env and are never read by the frontend.

NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org

# Deployed contract addresses (Base Sepolia).
NEXT_PUBLIC_RLAY_TOKEN_ADDRESS=0xf41D131cbB040e7655C7Fc4C78c4Da54Bf9B06c0
NEXT_PUBLIC_RLAY_CLAIM_ADDRESS=0xa0B1Ac0f8b33d7df59d58C93030b50e93f1a2993

# Slots funded at deploy time (20,000,000 RLAY pool / 1,000,000 per claim).
# The contract does not store the initial pool size, so the UI needs it here.
NEXT_PUBLIC_TOTAL_CLAIM_SLOTS=20

# WalletConnect/Reown Project ID for RainbowKit. Public value, safe to commit
# a real one if you want - it identifies the app, not a user or a wallet.
# Get one at https://cloud.reown.com (free, email signup, "Create Project").
NEXT_PUBLIC_WC_PROJECT_ID=
