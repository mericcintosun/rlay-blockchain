# Base Sepolia testnet RPC endpoint. Public default works; a dedicated
# Alchemy/Infura endpoint is more reliable during the camp.
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Test wallet private key. NEVER use a wallet that holds real funds.
# NEVER commit the real .env file.
PRIVATE_KEY=0x

# Basescan API key for source verification (forge verify-contract / --verify).
# Get one free at https://basescan.org/myapikey
BASESCAN_API_KEY=
