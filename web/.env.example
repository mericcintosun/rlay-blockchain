# Web app environment. Copy to .env.local for local development.
# .env.local is gitignored - never commit the real value.

# 4-digit code that unlocks slide navigation at /slaytlar.
# Read only on the server (app/api/slaytlar/unlock/route.ts). Never sent to the
# browser, so it must NOT be prefixed with NEXT_PUBLIC_.
# On Vercel: Project Settings -> Environment Variables.
SLIDE_PASSCODE=
